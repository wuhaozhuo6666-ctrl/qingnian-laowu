page{background:#f4f2eb;color:#26382f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:24rpx 24rpx 60rpx}.hero{border-radius:20rpx;overflow:hidden;position:relative;height:440rpx;background:#203a2d}.hero image{width:100%;height:100%}.hero-copy{position:absolute;left:28rpx;right:28rpx;bottom:28rpx;color:#fff;text-shadow:0 2rpx 12rpx #000}.hero-copy text{display:block}.hero-title{font-size:54rpx;font-family:serif}.hero-sub{font-size:24rpx;margin-top:12rpx}.nav{display:flex;gap:14rpx;overflow-x:auto;padding:26rpx 0}.nav-item{white-space:nowrap;padding:14rpx 24rpx;border:1rpx solid #ccd3c7;border-radius:40rpx;background:#fff}.nav-item.active{background:#304e3c;color:#fff}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.card{background:#fffef9;border-radius:16rpx;overflow:hidden}.card image{width:100%;height:260rpx}.card-copy{padding:16rpx}.card-title{display:block;font-size:30rpx;font-weight:600}.muted{color:#71786f;font-size:23rpx}.tag{display:inline-block;margin-top:8rpx;padding:5rpx 12rpx;border-radius:20rpx;background:#e7eadf;font-size:21rpx}.empty{text-align:center;color:#687168;padding:100rpx 20rpx}.section-title{font-size:40rpx;font-family:serif;margin:30rpx 0 20rpx}.button{background:#304e3c;color:#fff;border-radius:44rpx;font-size:28rpx}.button.light{background:#fff;color:#304e3c;border:1rpx solid #aeb9aa}.panel{background:#fffef9;border-radius:18rpx;padding:24rpx;margin-bottom:20rpx}
