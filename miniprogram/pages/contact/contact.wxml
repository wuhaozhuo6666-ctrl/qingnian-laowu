<view class="page"><view class="panel"><text class="section-title">到店看样</text><text>{{settings.storeAddress}}</text><text class="muted">{{settings.businessHours}}</text><text class="muted">{{settings.parkingInfo}}</text></view><text class="section-title">店内销售</text><view class="panel person" wx:for="{{sales}}" wx:key="id"><image src="{{item.imageUrl}}" mode="aspectFill"/><view><text class="card-title">{{item.name}}</text><text class="muted">{{item.title}}</text><button size="mini" data-value="{{item.wechat}}" bindtap="copy">复制微信号</button></view></view><text class="section-title">设计师</text><view class="panel person" wx:for="{{designers}}" wx:key="id"><image src="{{item.imageUrl}}" mode="aspectFill"/><view><text class="card-title">{{item.name}}</text><text class="muted">{{item.title}}</text><button size="mini" data-value="{{item.wechat}}" bindtap="copy">复制微信号</button></view></view></view>
