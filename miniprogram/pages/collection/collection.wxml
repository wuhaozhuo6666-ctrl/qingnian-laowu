<view class="page"><text class="section-title">我的选品清单</text><view class="grid"><view class="card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><image src="{{item.imageUrl}}" mode="aspectFill"/><view class="card-copy"><text class="card-title">{{item.name}}</text><text class="muted">{{item.id}}</text></view></view></view><view wx:if="{{!products.length}}" class="empty">清单还是空的，先去挑选家具吧。</view><button wx:if="{{products.length}}" class="button" open-type="share">发送可点击选品卡片</button></view>
