<view wx:if="{{product}}"><swiper class="gallery" indicator-dots circular><swiper-item wx:for="{{images}}" wx:key="*this"><image src="{{item}}" mode="aspectFit" data-src="{{item}}" bindtap="preview"/></swiper-item></swiper><view class="page"><view class="panel"><text class="price">{{product.benefitPrice||product.price}}</text><text wx:if="{{product.originalPrice}}" class="muted">原价 {{product.originalPrice}}</text><text class="title">{{product.name}}</text><text class="muted">编号 {{product.id}}</text><text class="desc">{{product.desc}}</text></view><view class="panel facts"><text>产品归属：{{product.brand}}</text><text>类型：{{product.category}}</text><text>木材：{{product.wood}}</text><text>尺寸：{{product.size||'请咨询门店'}}</text><text>状态：{{product.availability}}</text><text wx:if="{{product.stockQuantity}}">数量：{{product.stockQuantity}}</text><text>预计周期：{{product.leadTime}}</text><text>可改项目：{{product.options||'请咨询门店'}}</text></view><button class="button" bindtap="favorite">{{saved?'已加入选品清单':'加入选品清单'}}</button><button class="button light" open-type="share">分享这款家具</button></view></view>
